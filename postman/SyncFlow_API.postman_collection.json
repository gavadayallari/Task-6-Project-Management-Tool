    "name": "SyncFlow Project Management & Kanban API",
    "description": "Comprehensive Postman Collection for Auspify Technologies Full Stack Internship Task 5 (Project Management & Kanban Platform). Developed by Yallari Gavada.\n\nPrerequisites:\n1. Backend running on http://localhost:5002\n2. Run 'POST 1. Login (Admin)' to authenticate. The response test script automatically stores the JWT token in your environment variable 'syncflow_token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5002/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
